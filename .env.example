# Variables de entorno para Descargador de Expedientes
# =====================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. El archivo .env será ignorado por git (privado)
# 4. NUNCA commitees .env — solo .env.example
#
# En producción (Render/Railway): configurar estas variables
# desde el panel de la plataforma, NO usar archivo .env

# ═══════════════════════════════════════════════════════════════════════════
#  FLASK & SEGURIDAD
# ═══════════════════════════════════════════════════════════════════════════

# Ambiente: development, testing, production
FLASK_ENV=development

# Secret key para sesiones y CSRF
# CAMBIAR EN PRODUCCIÓN — generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ═══════════════════════════════════════════════════════════════════════════
#  BASE DE DATOS
# ═══════════════════════════════════════════════════════════════════════════

# Desarrollo: SQLite (local)
# Producción: PostgreSQL (Render provee la URL automáticamente)
# Ejemplo prod: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///app.db

# ═══════════════════════════════════════════════════════════════════════════
#  MERCADO PAGO (pagos)
# ═══════════════════════════════════════════════════════════════════════════

# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# URLs de retorno después del pago (ajustar dominio en producción)
MERCADO_PAGO_SUCCESS_URL=http://localhost:5000/pagos/pago-confirmado
MERCADO_PAGO_FAILURE_URL=http://localhost:5000/pagos/pago-fallido
MERCADO_PAGO_PENDING_URL=http://localhost:5000/pagos/pago-pendiente

# Webhook (solo en producción — Render/Railway da la URL pública)
# Configurar en el panel de MP: https://www.mercadopago.com.ar/developers/panel/app
# MERCADO_PAGO_NOTIFICATION_URL=https://tu-dominio.onrender.com/pagos/webhook

# Secret para validar webhooks de Mercado Pago (HMAC-SHA256)
# Obtener del panel de MP → Configuración de webhooks
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret-aqui

# ═══════════════════════════════════════════════════════════════════════════
#  REDIS (Celery - tareas asincrónicas)
# ═══════════════════════════════════════════════════════════════════════════

# Local: redis://localhost:6379/0
# Cloud: usar Upstash (free tier) o Redis Cloud
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════
#  MESA VIRTUAL (sesión de scraping)
# ═══════════════════════════════════════════════════════════════════════════

# Ruta donde guardar la sesión de Mesa Virtual (cookies).
# En Docker: apuntar a un volumen persistente.
# Si no se configura, usa ~/.mesa_virtual_sesion.pkl
# MESA_VIRTUAL_SESSION_PATH=/data/sesion.pkl

# ═══════════════════════════════════════════════════════════════════════════
#  CLOUD / DEPLOY
# ═══════════════════════════════════════════════════════════════════════════

# Horas que un PDF permanece en disco (output/) antes de ser borrado
# automáticamente. Reduce para servidores con poco disco. Default: 24
PDF_TTL_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════
#  STORAGE DE PDFS (Cloudflare R2 — S3-compatible)
# ═══════════════════════════════════════════════════════════════════════════

# Credenciales del bucket R2 (panel de Cloudflare → R2 → Manage API Tokens).
# Si alguna falta, la app cae a un backend local en disco (PDF_STORE_DIR) sin
# romper — solo se pierde la persistencia de largo plazo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Carpeta local del backend de storage cuando R2 no está configurado
# (desarrollo). Default: PROJECT_DIR/pdf_store
# PDF_STORE_DIR=/data/pdfs

# Días desde el último acceso que se conserva un PDF en el storage antes de
# purgarlo. Default: 180
RETENCION_PDF_DIAS=180

# URL base pública de la app (para armar links absolutos en emails enviados
# desde un thread en background, sin request context). Default: https://foja.com.ar
BASE_URL=https://foja.com.ar

# Cantidad de PDFs a unir por lote (menor = menos memoria, más lento).
# Para servidores con 512 MB RAM, usar 5-10. Default: 10
LOTE_UNIFICACION=10

# Activar compresión de PDF (requiere Ghostscript instalado).
# Consume CPU extra. Desactivado por defecto.
COMPRIMIR_PDF=false

# Calidad de compresión: screen (72dpi), ebook (150dpi), printer (300dpi)
COMPRESION_CALIDAD=ebook

# ═══════════════════════════════════════════════════════════════════════════
#  SEGURIDAD AVANZADA
# ═══════════════════════════════════════════════════════════════════════════

# Orígenes CORS permitidos (separados por coma)
# Ejemplo: https://tu-app.onrender.com,https://www.tu-dominio.com
CORS_ALLOWED_ORIGINS=https://tu-dominio.onrender.com

# Clave de cifrado para cookies de Mesa Virtual (base64)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tu-encryption-key-aqui

# ═══════════════════════════════════════════════════════════════════════════
#  CONTACTO Y SOPORTE
# ═══════════════════════════════════════════════════════════════════════════

# Email de soporte (destinatario de los mensajes del formulario de contacto)
CONTACT_EMAIL=soporte@tudominio.com

# WhatsApp de soporte (opcional — número con código de país, sin + ni espacios)
# Ejemplo: 5493412345678 para un número de Rosario, Argentina
# CONTACT_WHATSAPP=5493412345678

# ═══════════════════════════════════════════════════════════════════════════
#  EMAIL / SMTP (Flask-Mail)
# ═══════════════════════════════════════════════════════════════════════════

# Servidor SMTP — Gmail: smtp.gmail.com | Outlook: smtp.office365.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Cuenta desde la que se envían los correos
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# Dirección que aparece como remitente (puede ser igual a MAIL_USERNAME)
MAIL_DEFAULT_SENDER=tu-cuenta@gmail.com
